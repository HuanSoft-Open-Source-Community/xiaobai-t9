# ===== t9s2t 运行时下载物：语音模型 + 原生引擎（合计约 310MB，绝不入库）=====
# 模型由 t9s2t 首次运行时自动下载到 exe 同目录；
# onnxruntime.dll / sherpa-onnx-c-api.dll 由 engine.json 在线分发。
# 注意：打包源目录 output/t9s2t/ 下也会出现这些文件（在 output/ 下跑过 t9s2t 就会有），
#       install.nsi 已用 /x 把它们排除出安装包，这里再排除出仓库。
**/model/
/output/t9s2t/onnxruntime.dll
/output/t9s2t/sherpa-onnx-c-api.dll
/output/t9s2t/ad_state.txt

# ===== 待上传的分发文件（二进制，非源码）=====
/t9s2t/server_upload/

# ===== 本地回滚备份：改动前的快照，不入库 =====
*.bak-*

# ===== 工具 / 工作目录 =====
.workbuddy/
_resx_dump/


# ARM64 构建产物与工具目录（2026-10-14 新增）
/output/ARM64/
/lib64arm/rime.*

# ===== ARM64 构建中间目录（2026-11-11）=====
# 项目内 $(IntDir)/$(OutDir) 相对路径产生的中间目录
/ARM64/
/*/ARM64/
# 本地临时备份目录与测试源
numkeyboard/_backup_*/
arm64x_wrapper/t_dummy.c
numkeyboard/numkeyboard/obj/Debug/numkeyboard.exe.config

# arm64-patches 里的 env.bat 是 librime 子模块补丁内容，必须入库
!arm64-patches/librime/env.bat


